# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Discord OAuth (app/api/auth/login, lib/auth/oauth-callback.ts) ---
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/auth/callback

# --- Bot / internal APIs (lib/discord/rest.ts, app/api/status/shard) ---
DISCORD_BOT_TOKEN=
BOT_ID=
INTERNAL_API_BASE_URL=http://localhost:2845
# Shared secret checked against the Authorization header on internal routes
# (e.g. app/api/status/shard) called by the bot's gateway process.
SERVER_TOKEN=

# --- Session / database (lib/session.ts, lib/token-crypto.ts, lib/prisma.ts) ---
# Used to sign/verify the session JWT cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
# Used to encrypt/decrypt Session.accessToken and Session.refreshToken at
# rest (see lib/token-crypto.ts). Must decode to exactly 32 bytes. Generate
# with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Pooled connection string used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string. Only read by prisma.config.ts, i.e.
# only needed to run `prisma generate`/`prisma migrate` locally or at image
# build time — never used by the running app.
DIRECT_URL=

# --- Admin (lib/admin/guards.ts) ---
# Comma-separated Discord user IDs granted admin-only routes.
ADMIN_USER_IDS=